<Window x:Class="ProjectName.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectName.Wpf.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Проектный расчёт" Height="720" Width="960"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Блок 1: данные по проекту -->
        <Border Grid.Row="0"
                BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Данные по проекту"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Название" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentCalculation.Project.Name}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Ответственный" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentCalculation.Project.Responsible}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Дата начала" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentCalculation.Project.StartDate, StringFormat=d}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Дата окончания" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentCalculation.Project.EndDate, StringFormat=d}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Статус" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentCalculation.Project.Status}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentCalculation.Project.Description}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Сохранить расчёт"
                        Padding="20,8"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0"
                        Command="{Binding SaveCalculationCommand}"/>
            </Grid>
        </Border>

        <!-- Блок 2: задачи (пары) -->
        <Border Grid.Row="1"
                BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Задачи по этапам"
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PairItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StageTaskPairViewModel}">
                                <Border BorderBrush="#EEE" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding StageName}"
                                                       FontWeight="SemiBold" Foreground="#555"/>
                                            <TextBlock Text="{Binding TaskName}" FontSize="14"/>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="#888" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Сохранить пару"
                                                    Padding="10,4" Margin="0,0,8,0"
                                                    Command="{Binding SavePairCommand}"/>
                                            <Button Content="Открыть детали"
                                                    Padding="10,4"
                                                    Command="{Binding OpenDetailsCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Блок 3: отправить на рассмотрение -->
        <Button Grid.Row="2"
                Content="Отправить на рассмотрение"
                HorizontalAlignment="Right"
                Padding="20,8"
                Command="{Binding SendForReviewCommand}"/>
    </Grid>
</Window>