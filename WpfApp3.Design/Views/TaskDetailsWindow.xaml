<Window x:Class="ProjectName.Wpf.Views.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectName.Wpf.Views"
        xmlns:vm="clr-namespace:ProjectName.Wpf.ViewModels"
        xmlns:ab="clr-namespace:ProjectName.Wpf.ViewModels.AgreementBlocks"
        Title="Детали задачи" Width="640" Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" Foreground="#666"/>
            <TextBlock Text="{Binding TaskName}" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Margin="0,16,0,0"
                    ItemsSource="{Binding Blocks}"
                    SelectedItem="{Binding SelectedBlock}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.Resources>
                <DataTemplate DataType="{x:Type ab:TechnicalSpecialistAgreementViewModel}">
                    <views:TechnicalSpecialistTabView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type ab:GroupLeadAgreementViewModel}">
                    <views:GroupLeadTabView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type ab:BlockLeadAgreementViewModel}">
                    <views:BlockLeadTabView/>
                </DataTemplate>
            </TabControl.Resources>
        </TabControl>

        <!-- Кнопки (общие для окна) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить черновик"
                    Padding="16,6" Margin="0,0,8,0"
                    Command="{Binding SaveDraftCommand}"/>
            <Button Content="Подтвердить выполнение"
                    Padding="16,6"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Window>