<Window x:Class="ProjectName.Wpf.Views.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectName.Wpf.Views"
        xmlns:vm="clr-namespace:ProjectName.Wpf.ViewModels"
        Title="Детали задачи" Width="720" Height="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" Foreground="#666"/>
            <TextBlock Text="{Binding TaskName}" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <!-- Внешний TabControl — роли -->
        <TabControl Grid.Row="1" Margin="0,16,0,0"
                    ItemsSource="{Binding RoleTabs}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!-- Внутренний TabControl — варианты -->
                    <TabControl ItemsSource="{Binding Variants}">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Header" Value="{Binding DisplayName}"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <views:AgreementBlockView DataContext="{Binding Block}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить черновик"
                    Padding="16,6" Margin="0,0,8,0"
                    Command="{Binding SaveDraftCommand}"/>
            <Button Content="Подтвердить выполнение"
                    Padding="16,6"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Window>