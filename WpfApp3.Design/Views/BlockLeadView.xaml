<UserControl x:Class="ProjectName.Wpf.Views.BlockLeadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <CheckBox Content="Согласовать" IsChecked="{Binding IsAgreed}"/>

        <TextBlock Text="Бизнес-план" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <DataGrid x:Name="PlanGrid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  Height="240"/>

        <TextBlock Text="Комментарий" Margin="0,12,0,4"/>
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="80" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</UserControl>