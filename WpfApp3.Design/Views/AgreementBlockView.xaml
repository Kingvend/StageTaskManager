<UserControl x:Class="ProjectName.Wpf.Views.AgreementBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <CheckBox Content="Согласовать"
                  IsChecked="{Binding IsAgreed}"/>

        <TextBlock Text="Комментарий" Margin="0,12,0,4"/>
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="120"
                 VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</UserControl>